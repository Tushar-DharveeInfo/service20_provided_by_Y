{
  "name": "service20",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Service20 app",
  "scripts": {
    "setup": "node scripts/sync-all-config.js",
    "dev": "vite --port 3000 --open",
    "start": "vite --port 3000 --open",
    "build": "tsc --noEmit && node scripts/sync-all-config.js --env .env.production && vite build",
    "sync-config": "node scripts/sync-all-config.js",
    "preview": "vite preview",
    "lint": "eslint .",
    "deploy": "npm run build && firebase deploy",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "preinstall": "node -e \"const v=parseInt(process.versions.node.split('.')[0]); if(v<24){process.stderr.write('WARNING: Node '+process.versions.node+' detected. Node >=24.0.0 is required.\\n');}\""
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^7.0.1",
    "@n20a/libalerts": "^1.1.10",
    "@n20a/libauth": "^1.3.15",
    "@n20a/libavnotes": "^1.2.26",
    "@n20a/libaxios": "^1.0.3",
    "@n20a/libflippdf": "^1.0.11",
    "@n20a/libform": "^1.3.39",
    "@n20a/libfsdb": "^1.0.6",
    "@n20a/libicon": "^1.2.26",
    "@n20a/libmcpclient": "^1.0.36",
    "@n20a/libmiscfn": "^1.1.10",
    "ag-grid-community": "^35.0.0",
    "ag-grid-react": "^35.0.0",
    "axios": "^1.16.1",
    "file-saver": "^2.0.5",
    "html-react-parser": "^5.2.11",
    "lodash": "^4.17.21",
    "markdown-it": "^14.1.0",
    "primereact": "^10.9.7",
    "rc-tree": "^5.13.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.5.0",
    "react-zoom-pan-pinch": "^4.0.4",
    "styled-components": "^6.1.17",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/file-saver": "^2.0.7",
    "@types/lodash": "^4.17.16",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.28.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0",
    "vite": "^6.3.5"
  }
}
